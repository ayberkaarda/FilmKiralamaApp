<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sessions can only be issued by AuthService and SetupService; tests build them directly. -->
    <InternalsVisibleTo Include="FilmKiralama.Business.Tests" />
    <InternalsVisibleTo Include="FilmKiralama.Data.Tests" />
    <InternalsVisibleTo Include="FilmKiralama.UI.Tests" />
    <!-- Lets Moq create proxies of internal types. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FilmKiralama.Domain\FilmKiralama.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
  </ItemGroup>

</Project>
